{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clinic-realtime",
  "main": "worker.js",
  "compatibility_date": "2026-10-26",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "CLINIC_HUB",
        "class_name": "ClinicRealtimeHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ClinicRealtimeHub"]
    }
  ],
  "vars": {
    "VERIFY_URL": "https://feature-clinic-settings-logs.clinic-manger.pages.dev/api/doctor/verify"
  }
}
